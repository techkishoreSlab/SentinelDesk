# SentinelDesk environment template. Placeholders only — never put real secrets here.
# Copy with `scripts/dev-init.sh`, which generates random development secrets into `.env`.

# --- Application ---
APP_ENV=development
APP_NAME=SentinelDesk
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:5173
LOG_LEVEL=INFO
# Must be >= 32 random characters. dev-init.sh generates one.
SESSION_SECRET=replace-with-random-development-secret
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Owner account (migrations only) and least-privilege runtime role `sentinel_app`.
# Host-side URLs; inside Docker Compose the host is overridden to `postgres`.
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=replace-with-random-development-password
POSTGRES_DB=sentinel
APP_DB_PASSWORD=replace-with-random-app-role-password
MIGRATION_DATABASE_URL=
DATABASE_URL=
# dev-init.sh fills both URLs from the values above.

# --- Local development authentication (disable in production unless explicitly required) ---
LOCAL_AUTH_ENABLED=true
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# --- Job signing (Ed25519, PEM). Generated by dev-init.sh into git-ignored dev-keys/ ---
JOB_SIGNING_PRIVATE_KEY_PATH=
JOB_SIGNING_PUBLIC_KEY_PATH=

# --- Gemini (Phase 6). Server-side only. ---
# Use a current flash model from AI Studio (gemini-2.0-flash is retired).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_OUTPUT_TOKENS=256

# --- Microsoft Entra ID (optional; all four or none) ---
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Leave empty to use ${WEB_BASE_URL}/api/v1/auth/callback (served through the web origin so the
# session cookie lands on the browser's origin). Register exactly this URI in Entra.
ENTRA_REDIRECT_URI=
# Create an EMPLOYEE-only account on first Entra login. Elevated roles are always assigned manually.
ENTRA_JIT_PROVISIONING=true

# --- Microsoft Graph / Outlook (optional; requires Entra vars) ---
GRAPH_SENDER=
GRAPH_SCOPES=

# --- Threat intelligence (Phase 5). Mandatory check: empty key => INDETERMINATE => fail closed ---
# Hash lookup only (never upload binaries). Internal digest pins cover local demo packages.
THREAT_INTEL_PROVIDER=virustotal
THREAT_INTEL_API_KEY=
THREAT_INTEL_MANDATORY=true
THREAT_INTEL_CACHE_TTL_SECONDS=3600
THREAT_INTEL_DENIED_DIGESTS=
THREAT_INTEL_PINNED_DIGESTS=

# --- Endpoint lifecycle ---
DEVICE_ENROLLMENT_TTL_MINUTES=10
JOB_TTL_MINUTES=15
HEARTBEAT_INTERVAL_SECONDS=60
DEVICE_CREDENTIAL_TTL_DAYS=30
DEVICE_STALE_AFTER_SECONDS=900
# Mac package store used by catalogue ingest + the local agent (Compose mounts this path).
PACKAGE_STORE_DIR=/Users/Shared/SentinelDesk/packages
# Max package size for catalogue upload / URL import (pkg, dmg, zip). Default 2 GiB.
CATALOGUE_MAX_PACKAGE_BYTES=2147483648
